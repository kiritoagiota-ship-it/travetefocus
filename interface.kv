#:import rgba kivy.utils.get_color_from_hex
#:import dp   kivy.metrics.dp
#:import sp   kivy.metrics.sp
#:import EfeitoBordaAcesa animacoes_ui.EfeitoBordaAcesa

# ── Defaults globais ─────────────────────────────────────────
<Label>:
    font_name: "rajdhani.ttf"
<TextInput>:
    font_name: "rajdhani.ttf"
<Button>:
    font_name: "rajdhani.ttf"
<ScrollView>:
    effect_cls: EfeitoBordaAcesa

# ════════════════════════════════════════════════════════════
#  BOTÃO ANGULAR SCI-FI — Chanfro 20px visível
# ════════════════════════════════════════════════════════════
<BotaoAngular>:
    background_normal:  ""
    background_color:   0, 0, 0, 0
    markup:             True
    color:              self.cor_texto
    font_size:          "15sp"
    canvas.before:
        PushMatrix
        Scale:
            xyz:    (self.escala, self.escala, 1)
            origin: self.center
        # Fundo sólido — 0.12 em vez de 0.18 para cor de fundo mais visível
        Color:
            rgba: (self.cor_borda[0]*0.25, self.cor_borda[1]*0.25, self.cor_borda[2]*0.25, 0.96) if self.state == "down" else (self.cor_fundo[0], self.cor_fundo[1], self.cor_fundo[2], 0.98)
        Rectangle:
            pos:  self.pos
            size: self.size
        # Faixas de "varredura" internas (detalhe holográfico)
        Color:
            rgba: (self.cor_borda[0], self.cor_borda[1], self.cor_borda[2], 0.04)
        Rectangle:
            pos:  (self.x, self.center_y - 0.5)
            size: (self.width, 1)
        # Cortes angulares — dp(18) escala em qualquer densidade
        Color:
            rgba: 0.02, 0.02, 0.05, 1
        Triangle:
            points: [self.x, self.y, self.x+dp(18), self.y, self.x, self.y+dp(18)]
        Triangle:
            points: [self.right-dp(18), self.y, self.right, self.y, self.right, self.y+dp(18)]
        Triangle:
            points: [self.x, self.top-dp(18), self.x, self.top, self.x+dp(18), self.top]
        Triangle:
            points: [self.right-dp(18), self.top, self.right, self.top, self.right, self.top-dp(18)]
        # Halo de respiração
        Color:
            rgba: (self.cor_borda[0], self.cor_borda[1], self.cor_borda[2], self.brilho * 0.60)
        Line:
            points: [self.x+dp(18), self.y, self.right-dp(18), self.y, self.right, self.y+dp(18), self.right, self.top-dp(18), self.right-dp(18), self.top, self.x+dp(18), self.top, self.x, self.top-dp(18), self.x, self.y+dp(18), self.x+dp(18), self.y]
            width:  6
        # Borda chanfrada principal
        Color:
            rgba: self.cor_borda
        Line:
            points: [self.x+dp(18), self.y, self.right-dp(18), self.y, self.right, self.y+dp(18), self.right, self.top-dp(18), self.right-dp(18), self.top, self.x+dp(18), self.top, self.x, self.top-dp(18), self.x, self.y+dp(18), self.x+dp(18), self.y]
            width:  1.8
        # Linha interna de detalhe
        Color:
            rgba: (self.cor_borda[0], self.cor_borda[1], self.cor_borda[2], 0.14)
        Line:
            points: [self.x+dp(22), self.y+dp(4), self.right-dp(22), self.y+dp(4), self.right-dp(4), self.y+dp(22), self.right-dp(4), self.top-dp(22), self.right-dp(22), self.top-dp(4), self.x+dp(22), self.top-dp(4), self.x+dp(4), self.top-dp(22), self.x+dp(4), self.y+dp(22), self.x+dp(22), self.y+dp(4)]
            width:  1
    canvas.after:
        PopMatrix

# Vermelho destrutivo
<BotaoAngularAlerta>:
    cor_borda:    [1.0, 0.18, 0.28, 0.9]
    cor_borda_kv: [1.0, 0.18, 0.28, 0.9]
    cor_fundo:    [0.14, 0.02, 0.04, 0.92]
    cor_texto:    [1.0, 0.35, 0.42, 1.0]
    markup:       True

# Roxo operador
<BotaoAngularOperador>:
    cor_borda:    [0.58, 0.10, 0.92, 0.9]
    cor_borda_kv: [0.58, 0.10, 0.92, 0.9]
    cor_fundo:    [0.10, 0.02, 0.20, 0.92]
    cor_texto:    [0.78, 0.45, 1.00, 1.0]

# BotaoAngularMenu — herda BotaoAngular; breathing gerenciado em Python

# ════════════════════════════════════════════════════════════
#  LISTA ITEM ANGULAR
# ════════════════════════════════════════════════════════════
<ListaItem>:
    background_normal: ""
    background_color:  0, 0, 0, 0
    color:             self.cor_texto
    size_hint_y:       None
    height:            dp(68)
    font_size:         "15sp"
    halign:            "left"
    valign:            "middle"
    text_size:         self.size
    markup:            True
    canvas.before:
        PushMatrix
        Scale:
            xyz:    (self.escala, self.escala, 1)
            origin: self.center
        Color:
            rgba: (0, 0.9, 1, 0.10) if self.state == "down" else self.cor_fundo
        Rectangle:
            pos:  self.pos
            size: self.size
        # Corte direito em dp
        Color:
            rgba: 0.02, 0.02, 0.04, 1
        Triangle:
            points: [self.right-dp(12), self.y, self.right, self.y, self.right, self.y+dp(12)]
        Triangle:
            points: [self.right, self.top-dp(12), self.right-dp(12), self.top, self.right, self.top]
        # Acento esquerdo
        Color:
            rgba: self.cor_borda
        Rectangle:
            pos:  (self.x, self.y + dp(8))
            size: (dp(3), self.height - dp(16))
        # Borda
        Color:
            rgba: self.cor_borda
        Line:
            points: [self.x, self.y, self.right-dp(12), self.y, self.right, self.y+dp(12), self.right, self.top-dp(12), self.right-dp(12), self.top, self.x, self.top, self.x, self.y]
            width:  1.3
    canvas.after:
        PopMatrix

# Cartoes do Registro e das Memorias: SO a moldura do ListaItem. Sem o "-"
# eles herdavam tambem a do BotaoAngular (inteira escondida embaixo, com o
# Scale aplicado duas vezes) e o texto do Label (escondido): 2/3 do custo de
# cada cartao. Os textos sao desenhados pelo proprio cartao. (O "-" vale
# para os dois nomes: no Kivy ele so pode vir no primeiro.)
<-CartaoLote,CartaoMemoria>:
    background_normal: ""
    background_color:  0, 0, 0, 0
    size_hint_y:       None
    canvas.before:
        PushMatrix
        Scale:
            xyz:    (self.escala, self.escala, 1)
            origin: self.center
        Color:
            rgba: (0, 0.9, 1, 0.10) if self.state == "down" else self.cor_fundo
        Rectangle:
            pos:  self.pos
            size: self.size
        Color:
            rgba: 0.02, 0.02, 0.04, 1
        Triangle:
            points: [self.right-dp(12), self.y, self.right, self.y, self.right, self.y+dp(12)]
        Triangle:
            points: [self.right, self.top-dp(12), self.right-dp(12), self.top, self.right, self.top]
        Color:
            rgba: self.cor_borda
        Rectangle:
            pos:  (self.x, self.y + dp(8))
            size: (dp(3), self.height - dp(16))
        Color:
            rgba: self.cor_borda
        Line:
            points: [self.x, self.y, self.right-dp(12), self.y, self.right, self.y+dp(12), self.right, self.top-dp(12), self.right-dp(12), self.top, self.x, self.top, self.x, self.y]
            width:  1.3
    canvas.after:
        PopMatrix

# ════════════════════════════════════════════════════════════
#  INPUT HOLOGRÁFICO
#  ─────────────────────────────────────────────────────────
#  REGRAS CRÍTICAS:
#   1. multiline: False  — garante input de linha única
#   2. canvas.before usa APENAS RoundedRectangle + Line simples
#      (sem Triangle, sem PushMatrix/Scale)
#      → nenhum artefato de coordenadas que bloqueie o touch
#   3. A classe Python NÃO sobrescreve nenhum método de buffer
# ════════════════════════════════════════════════════════════
<InputHolografico>:
    multiline:         False
    background_normal: ""
    background_active: ""
    background_color:  0, 0, 0, 0
    foreground_color:  0, 0.9, 1, 1
    cursor_color:      0, 0.9, 1, 1
    padding:           [dp(14), max(0, (self.height - self.line_height) / 2.0)]
    # o FUNDO escuro e posto por baixo de tudo pela classe (InputHolografico):
    # aqui no canvas.before ele ficava POR CIMA do texto e o numero aparecia apagado
    canvas.after:
        Color:
            rgba: self.borda_color
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
            width: 1.6

# ════════════════════════════════════════════════════════════
#  BARRA CIRCULAR (XP ring)
# ════════════════════════════════════════════════════════════
<BarraCircular>:
    canvas.before:
        PushMatrix
        Rotate:
            angle:  self.angulo_anel_externo
            origin: self.center
        Color:
            rgba: rgba("#7a33cc88")
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 0, 30)
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 45, 75)
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 90, 120)
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 135, 165)
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 180, 210)
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 225, 255)
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 270, 300)
        Line:
            width:  2
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.1, 315, 345)
        PopMatrix
        Color:
            rgba: rgba("#0a0a1e")
        Line:
            width:  16
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.55)
        Color:
            rgba: root.cor_anel
        Line:
            width:  16
            circle: (self.center_x, self.center_y, min(self.width, self.height)/2.55, 0, self.angulo_preenchimento)

    # Apenas o % no centro — XP fica no lbl_xp_fracao abaixo do anel
    Label:
        text:      (f"{(root.valor_display/root.maximo*100) if root.maximo>0 else 0:.1f}%").replace('.', ',')
        font_name: "orbitron.ttf"
        font_size: "32sp"
        color:     root.cor_anel
        bold:      True
        halign:    "center"
        valign:    "middle"
        pos:       root.pos
        size:      root.size
        text_size: root.size

# ════════════════════════════════════════════════════════════
#  TELA LOADING
# ════════════════════════════════════════════════════════════
<TelaLoading>:
    name: "loading"
    FloatLayout:
        canvas.before:
            Color:
                rgba: rgba("#020204")
            Rectangle:
                pos:  self.pos
                size: self.size
        BoxLayout:
            pos_hint:  {"center_x": 0.5, "center_y": 0.73}
            size_hint: (0.92, 0.34)
            InfinitoLoader:
                id:        reator_shader
                texto:     "LOADING"
                size_hint: (1, 1)
        BoxLayout:
            orientation: 'horizontal'
            pos_hint:    {"center_x": 0.5, "center_y": 0.53}
            size_hint:   (0.98, None)
            height:      dp(90)
            spacing:     dp(6)
            EspadaHolografica:
                id:          espada_esq
                size_hint_x: None
                width:       dp(26)
                cor:         [0, 0.89, 1, 1]
            Label:
                id:        titulo_label
                text:      ""
                font_name: "orbitron.ttf"
                font_size: min(sp(34), self.width / 12.5) if self.width > 10 else sp(34)
                color:     rgba("#00e5ff")
                bold:      True
                halign:    "center"
                valign:    "middle"
                text_size: self.size
            EspadaHolografica:
                id:          espada_dir
                size_hint_x: None
                width:       dp(26)
                cor:         [0.55, 0.45, 1.0, 1]
                estilo:      'cristal'
        Label:
            id:        version_label
            text:      "[ NERVEGEAR SYSTEM V6.0 ]"
            font_name: "orbitron.ttf"
            font_size: "12sp"
            color:     rgba("#8a2be2")
            pos_hint:  {"center_x": 0.5, "center_y": 0.445}
            opacity:   0
        PainelHolografico:
            id:           terminal_box
            opacity:      0
            orientation:  'vertical'
            pos_hint:     {"center_x": 0.5, "center_y": 0.22}
            size_hint:    (0.88, 0.22)
            padding:      [dp(18), dp(12), dp(14), dp(12)]
            ScrollView:
                Label:
                    id:           console_text
                    text:         ""
                    font_name:    "rajdhani.ttf"
                    font_size:    "15sp"
                    color:        rgba("#a8f4ff")
                    halign:       "left"
                    valign:       "bottom"
                    size_hint_y:  None
                    height:       self.texture_size[1]
                    text_size:    self.width, None
                    markup:       True
        BarraCometa:
            id:        barra_loading
            opacity:   0
            pos_hint:  {"center_x": 0.5, "center_y": 0.06}
            size_hint: (0.88, None)
            height:    dp(24)
        Widget:
            id:        flash_overlay
            opacity:   0
            size_hint: (1, 1)
            canvas:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size

# ════════════════════════════════════════════════════════════
#  MENU PRINCIPAL
# ════════════════════════════════════════════════════════════
<MenuPrincipal>:
    name: "menu"
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.05, 1
        Rectangle:
            pos:  self.pos
            size: self.size
    HUDParallax:
        GridHolografico:
            size_hint: 1, 1
            pos_hint:  {'x': 0, 'y': 0}
        FundoAnimado:
            size_hint: 1, 1
        FloatLayout:
            size_hint: 1, 1

            # Tudo numa coluna: alturas fixas em dp e vaos que se ajustam a
            # altura da tela (antes era por fracao da tela e, num celular com
            # barras do Android e letra maior, o painel cobria o subtitulo)
            BoxLayout:
                orientation: 'vertical'
                size_hint:   1, 1
                padding:     [0, dp(16), 0, dp(6)]

                # ── Logo ─────────────────────────────────────────
                TituloLogo:
                    id:          titulo_menu
                    text:        "TRAVETE FOCUS"
                    font_name:   "orbitron.ttf"
                    font_size:   min(sp(32), self.width / 12.5) if self.width > 10 else sp(32)
                    bold:        True
                    size_hint_y: None
                    height:      dp(70)
                SubtituloHUD:
                    text:        "NERVEGEAR  //  AINCRAD EDITION"
                    font_name:   "orbitron.ttf"
                    font_size:   "9sp"
                    color:       0.66, 0.45, 1.0, 0.8
                    size_hint_y: None
                    height:      dp(18)
                Widget:
                    size_hint_y: 0.55

                # ── Painel vivo: hoje / nivel / sequencia ─────────
                PainelMenu:
                    id:        painel_menu
                    pos_hint:  {"center_x": 0.5}
                    size_hint: (0.88, None)
                    height:    dp(62)
                Widget:
                    size_hint_y: 0.45

                # ── Linha decorativa superior ─────────────────────
                Widget:
                    id:        linha_menu_1
                    pos_hint:  {"center_x": 0.5}
                    size_hint: (0.88, None)
                    height:    dp(1)
                    canvas:
                        Color:
                            rgba: rgba("#00e5ff33")
                        Rectangle:
                            pos:  self.pos
                            size: self.size
                Widget:
                    size_hint_y: 0.75

                # ── Botão principal SYSTEM LINK START ─────────────
                BotaoAngularMenu:
                    id:          btn_link_start
                    text:        "SYSTEM LINK START"
                    font_name:   "orbitron.ttf"
                    font_size:   min(sp(17), self.width / 18.5) if self.width > 10 else sp(17)
                    bold:        True
                    pos_hint:    {"center_x": 0.5}
                    size_hint:   (0.88, None)
                    height:      dp(64)
                    on_release:  app.link_start(self)
                Widget:
                    size_hint_y: 0.6

                # ── Linha decorativa ──────────────────────────────
                Widget:
                    id:        linha_menu_2
                    pos_hint:  {"center_x": 0.5}
                    size_hint: (0.70, None)
                    height:    dp(1)
                    canvas:
                        Color:
                            rgba: rgba("#8a2be222")
                        Rectangle:
                            pos:  self.pos
                            size: self.size
                Widget:
                    size_hint_y: 0.6

                # ── Botões secundários VERTICAIS com cores únicas ──
                BoxLayout:
                    id:          caixa_botoes_menu
                    orientation: 'vertical'
                    pos_hint:    {"center_x": 0.5}
                    size_hint:   (0.88, None)
                    height:      dp(220)
                    spacing:     dp(8)

                    # MEMÓRIAS — roxo (arquivo/histórico)
                    BotaoAngularMenu:
                        text:         ">>  MEMÓRIAS"
                        font_size:    "14sp"
                        cor_borda:    [0.55, 0.10, 0.92, 0.9]
                        cor_borda_kv: [0.55, 0.10, 0.92, 0.9]
                        cor_fundo:    [0.08, 0.02, 0.18, 0.95]
                        cor_texto:    [0.75, 0.40, 1.00, 1.0]
                        on_release:   app.mudar_tela("memorias")

                    # PROGRESSO — ciano (evolução/XP)
                    BotaoAngularMenu:
                        text:         ">>  PROGRESSO"
                        font_size:    "14sp"
                        cor_borda:    [0.00, 0.85, 1.00, 0.9]
                        cor_borda_kv: [0.00, 0.85, 1.00, 0.9]
                        cor_fundo:    [0.02, 0.10, 0.18, 0.95]
                        cor_texto:    [0.00, 0.90, 1.00, 1.0]
                        on_release:   app.mudar_tela("progresso")

                    # GANHOS — verde (dinheiro/produção)
                    BotaoAngularMenu:
                        text:         ">>  GANHOS"
                        font_size:    "14sp"
                        cor_borda:    [0.00, 1.00, 0.55, 0.9]
                        cor_borda_kv: [0.00, 1.00, 0.55, 0.9]
                        cor_fundo:    [0.02, 0.14, 0.08, 0.95]
                        cor_texto:    [0.00, 1.00, 0.55, 1.0]
                        on_release:   app.mudar_tela("ganhos")

                    # CALCULADORA — laranja (cálculo/tático)
                    BotaoAngularMenu:
                        text:         ">>  CALCULADORA"
                        font_size:    "14sp"
                        cor_borda:    [1.00, 0.60, 0.00, 0.9]
                        cor_borda_kv: [1.00, 0.60, 0.00, 0.9]
                        cor_fundo:    [0.16, 0.08, 0.00, 0.95]
                        cor_texto:    [1.00, 0.72, 0.00, 1.0]
                        on_release:   app.mudar_tela("calculadora")
                Widget:
                    size_hint_y: 0.4

                # ── Linha decorativa inferior ─────────────────────
                Widget:
                    id:        linha_menu_3
                    pos_hint:  {"center_x": 0.5}
                    size_hint: (0.88, None)
                    height:    dp(1)
                    canvas:
                        Color:
                            rgba: rgba("#00e5ff1a")
                        Rectangle:
                            pos:  self.pos
                            size: self.size
                Widget:
                    size_hint_y: 0.7

                # ── Vibracao, avisos e senha ──────────────────────
                BoxLayout:
                    pos_hint:    {"center_x": 0.5}
                    size_hint:   (0.88, None)
                    height:      dp(40)
                    spacing:     dp(10)
                    BotaoAngular:
                        text:        "VIBRAR: SIM" if app.vibracao else "VIBRAR: NÃO"
                        font_name:   "orbitron.ttf"
                        font_size:   "9sp"
                        size_hint_x: 0.34
                        cor_texto:   [0.0, 0.9, 1.0, 1.0] if app.vibracao else [0.45, 0.5, 0.56, 1.0]
                        on_release:  app.alternar_vibracao()
                    BotaoAngular:
                        text:        "AVISOS: SIM" if app.lembretes else "AVISOS: NÃO"
                        font_name:   "orbitron.ttf"
                        font_size:   "9sp"
                        size_hint_x: 0.34
                        cor_texto:   [0.0, 0.9, 1.0, 1.0] if app.lembretes else [0.45, 0.5, 0.56, 1.0]
                        on_release:  app.alternar_lembretes()
                    BotaoAngular:
                        text:        "SENHA"
                        font_name:   "orbitron.ttf"
                        font_size:   "9sp"
                        size_hint_x: 0.32
                        cor_texto:   [0.0, 0.9, 1.0, 1.0]
                        on_release:  app.trocar_senha()
                Widget:
                    size_hint_y: 0.5

                # ── Rodapé: o sistema e a VERSAO (legivel) ────────
                Label:
                    id:          rodape_menu
                    text:        "SISTEMA OPERACIONAL DE CONFECÇÃO  //  [color=#00e5ffcc]VERSÃO " + app.versao + "[/color]"
                    markup:      True
                    font_name:   "orbitron.ttf"
                    font_size:   "8.5sp"
                    color:       1, 1, 1, 0.3
                    size_hint_y: None
                    height:      dp(24)
                    halign:      "center"
                    valign:      "middle"
                    text_size:   self.size

# ════════════════════════════════════════════════════════════
#  TELA REGISTRO
#  CRÍTICO: GridHolografico tem pos_hint/size_hint explícitos
#  para não "vazar" coordenadas e bloquear os inputs.
# ════════════════════════════════════════════════════════════
<TelaRegistro>:
    name: "registro"
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.05, 1
        Rectangle:
            pos:  self.pos
            size: self.size
    GridHolografico:
        size_hint: 1, 1
        pos_hint:  {'x': 0, 'y': 0}
    BoxLayout:
        orientation: "vertical"
        padding:     [dp(16), dp(18), dp(16), dp(14)]
        spacing:     dp(10)
        size_hint:   1, 1
        Label:
            text:        "REGISTRO DIÁRIO"
            font_name:   "orbitron.ttf"
            font_size:   "20sp"
            color:       rgba("#00e5ff")
            bold:        True
            size_hint_y: None
            height:      dp(34)
            halign:      "center"
            valign:      "middle"
            text_size:   self.size
        # faixa da meta: hoje / meta do dia / ritmo / tempo que falta (toque: o painel)
        BotaoAngular:
            id:           lbl_meta_hoje
            text:         ""
            markup:       True
            font_name:    "rajdhani.ttf"
            font_size:    "14sp"
            size_hint_y:  None
            height:       dp(34)
            halign:       "center"
            valign:       "middle"
            text_size:    self.size
            cor_borda:    [0, 0.9, 1, 0.45]
            cor_borda_kv: [0, 0.9, 1, 0.45]
            on_release:   root.abrir_meta()
        InputHolografico:
            id:              nome_input
            hint_text:       "   Nome da Peça"
            hint_text_color: 0.32, 0.32, 0.50, 1
            font_size:       "17sp"
            size_hint_y:     None
            height:          dp(58)
        InputHolografico:
            id:              qtd_input
            hint_text:       "   Quantidade"
            hint_text_color: 0.32, 0.32, 0.50, 1
            font_size:       "17sp"
            size_hint_y:     None
            height:          dp(58)
            input_filter:    'int'
        BoxLayout:
            size_hint_y: None
            height:      dp(58)
            spacing:     dp(10)
            BotaoAngular:
                text:        ">>  Adicionar Lote"
                font_size:   "16sp"
                size_hint_x: 0.62
                on_release:  root.adicionar_item()
            BotaoAngular:
                text:         "COLAR DO\nWHATSAPP"
                font_size:    "12sp"
                halign:       "center"
                size_hint_x:  0.38
                cor_borda:    [0, 1, 0.55, 0.9]
                cor_borda_kv: [0, 1, 0.55, 0.9]
                cor_texto:    [0, 1, 0.55, 1.0]
                on_release:   root.colar_whatsapp()
        Widget:
            size_hint_y: None
            height:      dp(1)
            canvas:
                Color:
                    rgba: rgba("#ffffff0c")
                Rectangle:
                    pos:  self.pos
                    size: self.size
        Label:
            id:          lbl_filtro_ativo
            text:        "[color=#00e5ff]TODOS[/color]"
            markup:      True
            font_name:   "orbitron.ttf"
            font_size:   "11sp"
            color:       0, 0.9, 1, 0.55
            halign:      "left"
            valign:      "middle"
            size_hint_y: None
            height:      dp(20)
            text_size:   self.width, self.height
        Label:
            id:          empty_state
            text:        "[ SEM LOTES REGISTRADOS ]\n\nDigite o nome e a quantidade\npara iniciar o turno."
            font_name:   "orbitron.ttf"
            font_size:   "13sp"
            color:       rgba("#00e5ff22")
            halign:      "center"
            valign:      "middle"
            text_size:   self.size
            size_hint_y: None
            height:      dp(200)
            opacity:     1
        ScrollView:
            do_scroll_x:   False          # so rola na vertical: arrastar o lote para o lado e gesto dele
            GridLayout:
                id:            lista_container
                cols:          1
                size_hint_y:   None
                height:        self.minimum_height
                spacing:       dp(8)
                padding:       [0, dp(4), 0, dp(4)]
        BoxLayout:
            size_hint_y: None
            height:      dp(58)
            spacing:     dp(12)
            BotaoAngular:
                text:        "<<  Voltar"
                font_size:   "14sp"
                size_hint_x: 0.36
                on_release:  app.mudar_tela("menu")
            BotaoAngular:
                text:        ">>  Finalizar Dia"
                font_size:   "14sp"
                size_hint_x: 0.64
                cor_borda:   [0, 1, 0.55, 0.9]
                cor_borda_kv: [0, 1, 0.55, 0.9]
                cor_texto:   [0, 1, 0.55, 1.0]
                on_release:  root.finalizar_dia()

# ════════════════════════════════════════════════════════════
#  TELA MEMÓRIAS
# ════════════════════════════════════════════════════════════
<TelaMemorias>:
    name: "memorias"
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.05, 1
        Rectangle:
            pos:  self.pos
            size: self.size
    GridHolografico:
        size_hint: 1, 1
        pos_hint:  {'x': 0, 'y': 0}
    BoxLayout:
        orientation: "vertical"
        padding:     [dp(16), dp(18), dp(16), dp(14)]
        spacing:     dp(8)
        size_hint:   1, 1
        Label:
            text:        "BANCO DE MEMÓRIAS"
            font_name:   "orbitron.ttf"
            font_size:   "20sp"
            color:       rgba("#00e5ff")
            bold:        True
            size_hint_y: None
            height:      dp(40)
            halign:      "center"
            valign:      "middle"
            text_size:   self.size
        GraficoBarras:
            id:          grafico_barras
            size_hint_y: None
            height:      dp(130)
        Widget:
            size_hint_y: None
            height:      dp(4)
        ScrollView:
            size_hint_y: None
            height:      dp(46)
            do_scroll_y: False
            do_scroll_x: True
            BoxLayout:
                id:              filtros_container
                orientation:     'horizontal'
                size_hint_x:     None
                width:           self.minimum_width
                spacing:         dp(8)
                padding:         [dp(4), dp(4)]
        Widget:
            size_hint_y: None
            height:      dp(1)
            canvas:
                Color:
                    rgba: rgba("#ffffff0c")
                Rectangle:
                    pos:  self.pos
                    size: self.size
        ScrollView:
            id:            lista_scroll
            GridLayout:
                id:            memorias_container
                cols:          1
                size_hint_y:   None
                height:        self.minimum_height
                spacing:       dp(8)
                padding:       [0, dp(4), 0, dp(4)]
        BoxLayout:
            size_hint_y: None
            height:      dp(58)
            spacing:     dp(8)
            BotaoAngular:
                text:        "<<  Voltar"
                font_size:   "13sp"
                size_hint_x: 0.30
                on_release:  app.mudar_tela("menu")
            BotaoAngular:
                text:        ">>  EXPORTAR"
                font_size:   "13sp"
                size_hint_x: 0.40
                cor_borda:   [0, 0.9, 1, 0.9]
                cor_borda_kv:[0, 0.9, 1, 0.9]
                on_release:  root.exportar_historico()
            BotaoAngularAlerta:
                text:        "!!  WIPE"
                font_size:   "13sp"
                size_hint_x: 0.30
                on_release:  root.confirmar_wipe()

# ════════════════════════════════════════════════════════════
#  TELA PROGRESSO
# ════════════════════════════════════════════════════════════
<TelaProgresso>:
    name: "progresso"
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.05, 1
        Rectangle:
            pos:  self.pos
            size: self.size
    GridHolografico:
        size_hint: 1, 1
        pos_hint:  {'x': 0, 'y': 0}
    BoxLayout:
        orientation: "vertical"
        padding:     [dp(16), dp(12), dp(16), dp(12)]
        spacing:     dp(8)
        size_hint:   1, 1

        Label:
            text:        "SISTEMA DE PROGRESSO"
            font_name:   "orbitron.ttf"
            font_size:   "17sp"
            color:       rgba("#00e5ff")
            bold:        True
            size_hint_y: None
            height:      dp(30)
            halign:      "center"
            valign:      "middle"
            text_size:   self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height:      dp(68)
            spacing:     0
            canvas.before:
                Color:
                    rgba: rgba("#06061688")
                Rectangle:
                    pos:  self.pos
                    size: self.size
                Color:
                    rgba: rgba("#8a2be255")
                Line:
                    points: [self.x+12, self.y, self.right-12, self.y, self.right, self.y+12, self.right, self.top-12, self.right-12, self.top, self.x+12, self.top, self.x, self.top-12, self.x, self.y+12, self.x+12, self.y]
                    width:  1.4
            Label:
                id:        lbl_level_num
                text:      "LVL  1"
                font_name: "orbitron.ttf"
                font_size: "26sp"
                color:     rgba("#00e5ff")
                bold:      True
                halign:    "center"
                valign:    "middle"
                text_size: self.size
            Label:
                id:        lbl_titulo
                text:      "Novato da Cidade do Começo"
                font_name: "rajdhani.ttf"
                font_size: "14sp"
                color:     rgba("#aa55ff")
                halign:    "center"
                valign:    "middle"
                text_size: self.size

        Label:
            id:          lbl_streak
            text:        "SEQUÊNCIA  0  DIAS"
            font_name:   "orbitron.ttf"
            font_size:   "12sp"
            markup:      True
            color:       rgba("#00e5ff88")
            size_hint_y: None
            height:      dp(22)
            halign:      "center"
            valign:      "middle"
            text_size:   self.size

        BarraCircular:
            id:          barra_circular
            size_hint_y: 1

        Label:
            id:          lbl_xp_fracao
            text:        "0  /  800 XP"
            font_name:   "orbitron.ttf"
            font_size:   "14sp"
            color:       rgba("#00e5ffcc")
            size_hint_y: None
            height:      dp(26)
            halign:      "center"
            valign:      "middle"
            text_size:   self.size

        BoxLayout:
            size_hint_y: None
            height:      dp(56)
            spacing:     dp(6)
            canvas.before:
                Color:
                    rgba: rgba("#06061666")
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                id:        lbl_total_xp
                text:      "XP TOTAL\n[color=#00e5ff]0[/color]"
                markup:    True
                font_name: "rajdhani.ttf"
                font_size: "13sp"
                color:     rgba("#555577")
                halign:    "center"
                valign:    "middle"
                text_size: self.size
            Label:
                id:        lbl_total_pecas
                text:      "PEÇAS TOTAL\n[color=#00e5ff]0[/color]"
                markup:    True
                font_name: "rajdhani.ttf"
                font_size: "13sp"
                color:     rgba("#555577")
                halign:    "center"
                valign:    "middle"
                text_size: self.size
            Label:
                id:        lbl_melhor_dia
                text:      "MELHOR DIA\n[color=#ffcc00]0 un.[/color]"
                markup:    True
                font_name: "rajdhani.ttf"
                font_size: "13sp"
                color:     rgba("#555577")
                halign:    "center"
                valign:    "middle"
                text_size: self.size

        BotaoAngular:
            text:        "<<  Voltar"
            font_size:   "14sp"
            size_hint_y: None
            height:      dp(56)
            on_release:  app.mudar_tela("menu")

# ════════════════════════════════════════════════════════════
#  CALCULADORA TÁTICA
# ════════════════════════════════════════════════════════════
<TelaCalculadora>:
    name: "calculadora"
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.05, 1
        Rectangle:
            pos:  self.pos
            size: self.size
    GridHolografico:
        size_hint: 1, 1
        pos_hint:  {'x': 0, 'y': 0}
    BoxLayout:
        orientation: "vertical"
        padding:     [dp(14), dp(16), dp(14), dp(12)]
        spacing:     dp(8)
        size_hint:   1, 1
        Label:
            text:        "CÁLCULO TÁTICO"
            font_name:   "orbitron.ttf"
            font_size:   "19sp"
            color:       rgba("#00e5ff")
            bold:        True
            size_hint_y: None
            height:      dp(36)
            halign:      "center"
            valign:      "middle"
            text_size:   self.size
        # Ultimas contas (toque numa para usar o resultado), encostadas no visor
        BoxLayout:
            id:          calc_hist_area
            orientation: "vertical"
            size_hint_y: 1
            on_height:   root._mostrar_historico()
            Widget:
            BoxLayout:
                id:          calc_historico
                orientation: "vertical"
                size_hint_y: None
                height:      self.minimum_height
        # Visor: conta pequena em cima, numero grande embaixo
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height:      dp(104)
            padding:     [dp(14), dp(6), dp(14), dp(4)]
            canvas.before:
                Color:
                    rgba: rgba("#07071ccc")
                Rectangle:
                    pos:  self.pos
                    size: self.size
                Color:
                    rgba: rgba("#00e5ff44")
                Line:
                    points: [self.x+10, self.y, self.right-10, self.y, self.right, self.y+10, self.right, self.top-10, self.right-10, self.top, self.x+10, self.top, self.x, self.top-10, self.x, self.y+10, self.x+10, self.y]
                    width:  1.5
            Label:
                id:           calc_conta
                text:         ""
                font_name:    "orbitron.ttf"
                font_size:    "16sp"
                color:        0.45, 0.62, 0.70, 1
                halign:       "right"
                valign:       "middle"
                text_size:    self.size
                shorten:      True
                shorten_from: "left"
                size_hint_y:  None
                height:       dp(30)
            Label:
                id:           calc_display
                text:         ""
                font_size:    "44sp"
                font_name:    "orbitron.ttf"
                color:        rgba("#ffffff")
                halign:       "right"
                valign:       "middle"
                text_size:    self.size
                shorten:      True
                shorten_from: "left"
        # Teclas (como a calculadora do celular)
        GridLayout:
            cols:               4
            spacing:            dp(7)
            size_hint_y:        None
            row_force_default:  True
            row_default_height: dp(60)
            height:             self.minimum_height
            BotaoAngularAlerta:
                text:       "C"
                font_name:  "orbitron.ttf"
                font_size:  "22sp"
                tatil:      "tecla"
                on_press:   root.apertar("C")
            BotaoAngularOperador:
                text:       "( )"
                font_name:  "orbitron.ttf"
                font_size:  "22sp"
                tatil:      "tecla"
                on_press:   root.apertar("()")
            BotaoAngularOperador:
                text:       "%"
                font_name:  "orbitron.ttf"
                font_size:  "24sp"
                tatil:      "tecla"
                on_press:   root.apertar("%")
            BotaoAngularOperador:
                text:       "÷"
                font_name:  "orbitron.ttf"
                font_size:  "30sp"
                tatil:      "tecla"
                on_press:   root.apertar("/")
            BotaoAngular:
                text:       "7"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("7")
            BotaoAngular:
                text:       "8"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("8")
            BotaoAngular:
                text:       "9"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("9")
            BotaoAngularOperador:
                text:       "×"
                font_name:  "orbitron.ttf"
                font_size:  "30sp"
                tatil:      "tecla"
                on_press:   root.apertar("*")
            BotaoAngular:
                text:       "4"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("4")
            BotaoAngular:
                text:       "5"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("5")
            BotaoAngular:
                text:       "6"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("6")
            BotaoAngularOperador:
                text:       "−"
                font_name:  "orbitron.ttf"
                font_size:  "30sp"
                tatil:      "tecla"
                on_press:   root.apertar("-")
            BotaoAngular:
                text:       "1"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("1")
            BotaoAngular:
                text:       "2"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("2")
            BotaoAngular:
                text:       "3"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("3")
            BotaoAngularOperador:
                text:       "+"
                font_name:  "orbitron.ttf"
                font_size:  "30sp"
                tatil:      "tecla"
                on_press:   root.apertar("+")
            BotaoAngularAlerta:
                text:       "DEL"
                font_name:  "orbitron.ttf"
                font_size:  "17sp"
                tatil:      "tecla"
                on_press:   root.del_segurar()
                on_release: root.del_soltar()
            BotaoAngular:
                text:       "0"
                font_name:  "orbitron.ttf"
                font_size:  "28sp"
                tatil:      "tecla"
                on_press:   root.apertar("0")
            BotaoAngular:
                text:       ","
                font_name:  "orbitron.ttf"
                font_size:  "30sp"
                tatil:      "tecla"
                on_press:   root.apertar(".")
            BotaoAngular:
                text:       "="
                font_name:  "orbitron.ttf"
                font_size:  "30sp"
                tatil:      "tecla"
                cor_borda:    [0, 1, 0.55, 0.9]
                cor_borda_kv: [0, 1, 0.55, 0.9]
                cor_texto:    [0, 1, 0.55, 1]
                on_press:   root.apertar("=")
        # Linha final
        BoxLayout:
            size_hint_y: None
            height:      dp(48)
            spacing:     dp(10)
            BotaoAngular:
                text:        "<<  Voltar"
                size_hint_x: 0.34
                font_size:   "13sp"
                on_release:  app.mudar_tela("menu")
            Widget:

# ════════════════════════════════════════════════════════════
#  TELA GANHOS
#  Fluxo: Configure → Abra um período → Finalize turnos → Feche para calcular
# ════════════════════════════════════════════════════════════
<TelaGanhos>:
    name: "ganhos"
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.05, 1
        Rectangle:
            pos:  self.pos
            size: self.size
    GridHolografico:
        size_hint: 1, 1
        pos_hint:  {'x': 0, 'y': 0}
    BoxLayout:
        orientation: "vertical"
        padding:     [dp(16), dp(14), dp(16), dp(12)]
        spacing:     dp(10)
        size_hint:   1, 1

        # ── Título ──────────────────────────────────────────
        Label:
            text:        "CONTROLE DE GANHOS"
            font_name:   "orbitron.ttf"
            font_size:   "19sp"
            color:       rgba("#00ff88")
            bold:        True
            size_hint_y: None
            height:      dp(36)
            halign:      "center"
            valign:      "middle"
            text_size:   self.size

        # a PAGINA INTEIRA rola (antes so o historico rolava e, em celular
        # com a barra de navegacao, ele ficava espremido ate sumir)
        ScrollView:
            id:              rolagem
            do_scroll_x:     False
            bar_width:       dp(3)
            bar_color:       0, 0.9, 1, 0.55
            bar_inactive_color: 0, 0.9, 1, 0.18
            scroll_type:     ['bars', 'content']
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height:      self.minimum_height
                spacing:     dp(10)
                padding:     [0, 0, 0, dp(10)]

                # ══ CARD: PERÍODO + SEMANA (um quadro só) ════════════
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height:      self.minimum_height
                    spacing:     dp(6)
                    padding:     [dp(14), dp(10), dp(14), dp(12)]
                    canvas.before:
                        Color:
                            rgba: rgba("#07071ccc")
                        Rectangle:
                            pos:  self.pos
                            size: self.size
                        Color:
                            rgba: rgba("#00ff8866")
                        Line:
                            points: [self.x+dp(12), self.y, self.right-dp(12), self.y, self.right, self.y+dp(12), self.right, self.top-dp(12), self.right-dp(12), self.top, self.x+dp(12), self.top, self.x, self.top-dp(12), self.x, self.y+dp(12), self.x+dp(12), self.y]
                            width:  1.5

                    Label:
                        id:          lbl_periodo_status
                        text:        "[color=#444444]--  Nenhum período aberto  --[/color]"
                        markup:      True
                        font_name:   "orbitron.ttf"
                        font_size:   "11sp"
                        size_hint_y: None
                        height:      dp(22)
                        halign:      "center"
                        valign:      "middle"
                        text_size:   self.size

                    BoxLayout:
                        size_hint_y: None
                        height:      dp(50)
                        spacing:     dp(8)
                        Label:
                            id:        lbl_periodo_pecas
                            text:      ""
                            markup:    True
                            font_name: "rajdhani.ttf"
                            font_size: "15sp"
                            halign:    "center"
                            valign:    "middle"
                            text_size: self.size
                        Label:
                            id:        lbl_periodo_ganho
                            text:      ""
                            markup:    True
                            font_name: "rajdhani.ttf"
                            font_size: "15sp"
                            halign:    "center"
                            valign:    "middle"
                            text_size: self.size

                    # so aparece quando a semana (seg a sab) e diferente do periodo aberto
                    Label:
                        id:          lbl_semana_pecas
                        text:        ""
                        markup:      True
                        font_name:   "rajdhani.ttf"
                        font_size:   "14sp"
                        size_hint_y: None
                        height:      self.texture_size[1] + dp(4) if self.text else 0
                        opacity:     1 if self.text else 0
                        halign:      "center"
                        valign:      "middle"
                        text_size:   self.width, None

                    BarraMeta:
                        id:          barra_semana
                        size_hint_y: None
                        height:      dp(34)

                    Label:
                        id:          lbl_periodo_bonus
                        text:        ""
                        markup:      True
                        font_name:   "rajdhani.ttf"
                        font_size:   "14sp"
                        size_hint_y: None
                        height:      self.texture_size[1] + dp(6)
                        halign:      "center"
                        valign:      "middle"
                        text_size:   self.width, None

                    Label:
                        id:          lbl_semana_metas
                        text:        ""
                        markup:      True
                        font_name:   "rajdhani.ttf"
                        font_size:   "14sp"
                        size_hint_y: None
                        height:      self.texture_size[1] + dp(6) if self.text else 0
                        line_height: 1.15
                        halign:      "center"
                        valign:      "middle"
                        text_size:   self.width, None

                    BoxLayout:
                        size_hint_y: None
                        height:      dp(48)
                        spacing:     0              # so um dos dois aparece de cada vez
                        BotaoAngular:
                            id:           btn_abrir_periodo
                            text:         ">>  ABRIR PERÍODO"
                            font_size:    "13sp"
                            cor_borda:    [0, 1, 0.55, 0.9]
                            cor_borda_kv: [0, 1, 0.55, 0.9]
                            cor_texto:    [0, 1, 0.55, 1]
                            on_release:   root.abrir_periodo()
                        BotaoAngular:
                            id:           btn_fechar_periodo
                            text:         ">>  FECHAR E CALCULAR"
                            font_size:    "13sp"
                            cor_borda:    [1, 0.65, 0, 0.9]
                            cor_borda_kv: [1, 0.65, 0, 0.9]
                            cor_texto:    [1, 0.80, 0, 1]
                            opacity:      0
                            disabled:     True
                            on_release:   root.fechar_periodo()

                # ══ AJUSTES (recolhidos: abrem num toque) ══════════
                BotaoAngular:
                    id:          btn_ajustes
                    text:        "AJUSTES DO CÁLCULO   [color=#00e5ff88]v[/color]"
                    font_size:   "12sp"
                    size_hint_y: None
                    height:      dp(44)
                    on_release:  root.alternar_ajustes()

                BoxLayout:
                    id:          bloco_config
                    orientation: 'vertical'
                    size_hint_y: None
                    height:      0
                    opacity:     0
                    disabled:    True
                    spacing:     dp(6)
                    padding:     [dp(12), dp(10), dp(12), dp(10)]
                    canvas.before:
                        Color:
                            rgba: rgba("#04040e99")
                        Rectangle:
                            pos:  self.pos
                            size: self.size
                        Color:
                            rgba: rgba("#00e5ff22")
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
                            width: 1

                    BoxLayout:
                        size_hint_y: None
                        height:      dp(44)
                        spacing:     dp(8)
                        Label:
                            text:        "Base R$"
                            font_name:   "rajdhani.ttf"
                            font_size:   "14sp"
                            color:       rgba("#b4bed2")
                            size_hint_x: 0.22
                            halign:      "right"
                            valign:      "middle"
                            text_size:   self.size
                        InputHolografico:
                            id:           inp_valor_base
                            text:         "0,25"
                            input_filter: root.filtro_reais
                            font_size:    "16sp"
                            halign:       "center"
                            size_hint_x:  0.28
                        Label:
                            text:        "Bônus R$"
                            font_name:   "rajdhani.ttf"
                            font_size:   "14sp"
                            color:       rgba("#b4bed2")
                            size_hint_x: 0.22
                            halign:      "right"
                            valign:      "middle"
                            text_size:   self.size
                        InputHolografico:
                            id:           inp_valor_bonus
                            text:         "0,30"
                            input_filter: root.filtro_reais
                            font_size:    "16sp"
                            halign:       "center"
                            size_hint_x:  0.28

                    BoxLayout:
                        size_hint_y: None
                        height:      dp(44)
                        spacing:     dp(6)
                        Label:
                            text:        "Meio R$"
                            font_name:   "rajdhani.ttf"
                            font_size:   "14sp"
                            color:       rgba("#b4bed2")
                            size_hint_x: 0.22
                            halign:      "right"
                            valign:      "middle"
                            text_size:   self.size
                        InputHolografico:
                            id:           inp_valor_meio
                            text:         "0,27"
                            input_filter: root.filtro_reais
                            font_size:    "16sp"
                            halign:       "center"
                            size_hint_x:  0.28
                        Label:
                            text:        "a partir de"
                            font_name:   "rajdhani.ttf"
                            font_size:   "14sp"
                            color:       rgba("#b4bed2")
                            size_hint_x: 0.22
                            halign:      "right"
                            valign:      "middle"
                            text_size:   self.size
                        InputHolografico:
                            id:           inp_meta_meio
                            text:         "2500"
                            input_filter: 'int'
                            font_size:    "16sp"
                            halign:       "center"
                            size_hint_x:  0.28

                    BoxLayout:
                        size_hint_y: None
                        height:      dp(44)
                        spacing:     dp(6)
                        Label:
                            text:        "Bônus a partir"
                            font_name:   "rajdhani.ttf"
                            font_size:   "14sp"
                            color:       rgba("#b4bed2")
                            size_hint_x: 0.22
                            halign:      "right"
                            valign:      "middle"
                            text_size:   self.size
                        InputHolografico:
                            id:           inp_meta_bonus
                            text:         "3000"
                            input_filter: 'int'
                            font_size:    "16sp"
                            halign:       "center"
                            size_hint_x:  0.28
                        Label:
                            text:        "Sábado (pç)"
                            font_name:   "rajdhani.ttf"
                            font_size:   "14sp"
                            color:       rgba("#b4bed2")
                            size_hint_x: 0.22
                            halign:      "right"
                            valign:      "middle"
                            text_size:   self.size
                        InputHolografico:
                            id:           inp_sabado
                            text:         "200"
                            input_filter: 'int'
                            font_size:    "16sp"
                            halign:       "center"
                            size_hint_x:  0.28

                    BoxLayout:
                        size_hint_y: None
                        height:      dp(44)
                        spacing:     dp(8)
                        BotaoAngular:
                            id:          spin_tipo
                            text:        "Semanal"
                            font_size:   "12sp"
                            size_hint_x: 0.42
                            on_release:  root._ciclar_tipo()
                        BotaoAngular:
                            text:         ">>  SALVAR"
                            font_size:    "13sp"
                            size_hint_x:  0.58
                            cor_borda:    [0, 1, 0.55, 0.9]
                            cor_borda_kv: [0, 1, 0.55, 0.9]
                            cor_texto:    [0, 1, 0.55, 1]
                            on_release:   root.salvar_config()

                # ══ HISTÓRICO (todos, rolando com a página) ══════════
                Label:
                    text:        "HISTÓRICO DE PERÍODOS FECHADOS"
                    font_name:   "orbitron.ttf"
                    font_size:   "10sp"
                    color:       rgba("#00e5ffb0")
                    size_hint_y: None
                    height:      dp(22)
                    halign:      "center"
                    valign:      "middle"
                    text_size:   self.size

                GridLayout:
                    id:            historico_container
                    cols:          1
                    size_hint_y:   None
                    height:        self.minimum_height
                    spacing:       dp(7)
                    padding:       [0, dp(2), 0, dp(2)]

        BotaoAngular:
            text:        "<<  Voltar"
            font_size:   "14sp"
            size_hint_y: None
            height:      dp(54)
            on_release:  app.mudar_tela("menu")

# ════════════════════════════════════════════════════════════
#  ROOT
# ════════════════════════════════════════════════════════════
RootWidget:
    canvas.before:
        Color:
            rgba: 0.008, 0.008, 0.02, 1
        Rectangle:
            pos:  self.pos
            size: self.size
    Gerenciador:
        id: sm
        size_hint: (None, 1)
        width: min(root.width, dp(560)) if root.width > dp(640) else root.width
        pos_hint: {"center_x": 0.5}
        canvas.after:
            # bordas neon da coluna (so aparecem em janela larga)
            Color:
                rgba: (0, 0.9, 1, 0.22) if root.width > dp(640) else (0, 0, 0, 0)
            Line:
                points: [self.x, self.y, self.x, self.top]
                width: 1.2
            Line:
                points: [self.right, self.y, self.right, self.top]
                width: 1.2
        TelaLoading:
        MenuPrincipal:
        TelaRegistro:
        TelaMemorias:
        TelaProgresso:
        TelaGanhos:
        TelaCalculadora:
