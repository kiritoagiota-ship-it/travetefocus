<?xml version="1.0" encoding="utf-8"?>
<!-- Card de aviso FECHADO: o Yoru, o titulo, uma linha de texto e a barra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/notif_fundo"
    android:padding="6dp">

    <ImageView
        android:id="@+id/tf_yoru"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tf_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tf_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#C8D2E6"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/tf_barra"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00E5FF"
            android:progressBackgroundTint="#335A6A" />
    </LinearLayout>
</LinearLayout>
